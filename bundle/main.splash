fn fmt_money(n){ "$" + ("" + (round(n * 100) / 100)) }
fn time_text(epoch){
    let t = local_time(epoch)
    "" + t.year + "-" + pad2(t.month) + "-" + pad2(t.day) + " " + pad2(t.hour) + ":" + pad2(t.minute) + "（宿主时间）"
}
fn pad2(n){ if n < 10 { "0" + ("" + n) } else { "" + n } }

fn join_list(arr){
    let s = ""
    for v in arr {
        if s != "" { s = s + "、" }
        s = s + ("" + v)
    }
    s
}
fn td_text(td){
    let s = ""
    for k v in td {
        if v != nil {
            if s != "" { s = s + "；" }
            s = s + k + "=" + ("" + v)
        }
    }
    s
}
fn split_words(s){
    let out = []
    let parts = s.split(",")
    for p in parts {
        let subs = p.split(" ")
        for w in subs { if w != "" { out.push(w) } }
    }
    out
}

// User-entered terms are literal words, not regular expressions.
fn literal_match(term, text){
    if term == "" { return false }
    let escaped = ""
    for ch in term.split("") {
        if ch != "" {
            if ".^$|?*+()[]{}\\".search(ch) >= 0 { escaped = escaped + "\\" }
            escaped = escaped + ch
        }
    }
    regex(escaped, "i").test(text)
}
fn need_terms(text){
    let terms = split_words(text)
    // Small explicit vocabulary for the Chinese presets; this is rule matching.
    if regex("无线", "i").test(text) { terms.push("wireless") terms.push("Bluetooth") }
    if regex("鼠标", "i").test(text) { terms.push("mouse") }
    if regex("键盘", "i").test(text) { terms.push("keyboard") }
    if regex("办公", "i").test(text) { terms.push("office") }
    if regex("安静|静音", "i").test(text) { terms.push("quiet") terms.push("silent") }
    if regex("游戏|电竞", "i").test(text) { terms.push("gaming") }
    if regex("便携|旅行|笔记本", "i").test(text) { terms.push("slim") terms.push("compact") terms.push("travel") }
    terms
}

// 软偏好小词典：只覆盖 3 个预设中明确写出的偏好，不是完整语义理解。
// triggers 判断 need 是否真的提到该组；evidence_terms 是目录原始字段中可接受的证据别名。
// 词典范围仅限本演示目录；未列出不等于语义上不相关，也不代表商品一定不支持。
let preference_dict = [
    {preference: "quiet" label: "静音" triggers: ["安静", "静音", "quiet", "silent"] evidence_terms: ["quiet", "silent"]}
    {preference: "gaming" label: "游戏" triggers: ["游戏", "电竞", "gaming"] evidence_terms: ["gaming"]}
    {preference: "portable" label: "便携" triggers: ["便携", "旅行", "笔记本", "portable", "slim", "compact", "travel"] evidence_terms: ["portable", "slim", "compact", "travel"]}
]

// 目录原始字段的 field/value 对；value 保持原样（数组逐元素、technical_details 逐键）。
fn item_field_pairs(it){
    let out = []
    out.push({field: "title" value: it.title})
    out.push({field: "brand" value: it.brand})
    out.push({field: "description" value: it.description})
    for c in it.categories { out.push({field: "categories" value: c}) }
    for f in it.features { out.push({field: "features" value: f}) }
    for k v in it.technical_details {
        if v != nil { out.push({field: "technical_details." + k value: "" + v}) }
    }
    out
}

// 对给定 term 列表，在真实目录字段中 literal_match 命中的位置逐条记录 term/field/value；
// 只输出原始字段值，不生成“已满足”之类的合成引文。
fn build_evidence(it, terms){
    let out = []
    let pairs = item_field_pairs(it)
    for t in terms {
        if t != "" {
            for p in pairs {
                if literal_match(t, p.value) {
                    out.push({term: t field: p.field value: p.value})
                }
            }
        }
    }
    out
}

// 仅当 need 真的提到某组软偏好时，才为该候选生成一条核对（多个 aliases 只算一组）。
fn pref_checks(it, need_text){
    let out = []
    for g in preference_dict {
        let triggered = false
        for trig in g.triggers {
            if literal_match(trig, need_text) { triggered = true }
        }
        if triggered {
            let ev = build_evidence(it, g.evidence_terms)
            let status = "not_documented"
            if ev.len() > 0 { status = "documented" }
            out.push({preference: g.preference label: g.label evidence_status: status evidence: ev})
        }
    }
    out
}

fn clear_suggestion(){
    review_token = review_token + 1
    agent_answer_text = ""
    agent_request_proposal = ""
    agent_request_revision = -1
    agent_request_merchant = -1
    ui.agent_answer.set_text("")
    ui.agent_answer_json.set_text("")
    ui.agent_status.set_text("未请求审阅。")
}
fn proposal_inputs_match(){
    if proposal == nil { return false }
    proposal.need_text == ui.need_input.text() &&
        proposal.budget_text == ui.budget_input.text() &&
        proposal.hard_text == ui.keywords_input.text()
}

fn price_of(it){
    if has_price_shift {
        if it.item_id == price_shift_item {
            return round(it.price_usd * price_shift_factor * 100) / 100
        }
    }
    it.price_usd
}
fn find_item(id){
    let found = nil
    for it in catalog { if it.item_id == id { found = it } }
    found
}
// 合成目录商品的报价元数据：明确 synthetic_demo，不是任何官网来源；snapshot_price_usd 取目录价。
fn synthetic_quote(it){
    {variant: "" source_url: "" stock_at_observation: "not_applicable"
     facts_kind: "synthetic_demo" kind: "synthetic_demo_catalog"
     snapshot_id: "" observed_at: "" region: "N/A" currency: "USD"
     price_basis: "synthetic_demo_item_price" shipping_to_user: "not_applicable"
     tax_total: "not_applicable" merchant_quote_validity: "synthetic_demo"
     snapshot_price_usd: it.price_usd}
}
// 当前目录商品的报价元数据：官方快照直接返回内嵌 quote；合成目录返回合成的 synthetic_demo 元数据。
fn quote_of(it){
    if catalog_source == "official_snapshot" { return it.quote }
    synthetic_quote(it)
}
// 界面用自然语言展示出处；原始字段/枚举留在工具结果中。
fn catalog_source_name(source){
    if source == "official_snapshot" { return "官网报价快照" }
    if source == "synthetic_demo" { return "合成演示目录" }
    "旧版记录（无来源快照）"
}
fn quote_summary(q){
    if q == nil { return "报价来源：旧版记录未保存来源快照。" }
    let fk = history_field(q, "facts_kind")
    if fk != "curated_page_summary" {
        if fk == "synthetic_demo" { return "报价来源：合成演示数据，非真实报价。" }
        return "报价来源：旧版记录未保存来源快照。"
    }
    let s = "来源：Logitech 美国官网 · " + ("" + history_field(q, "variant")) + " · US/USD"
    s = s + "\n采集：" + ("" + history_field(q, "observed_at")) + "（UTC，非实时）"
    s = s + "\n快照商品价 " + fmt_money(history_field(q, "snapshot_price_usd")) + "；运费、税费和寄送地址待核对。"
    s = s + "\n采集时页面显示有货；当前库存与报价有效性未核验。规格为人工整理摘要。"
    s = s + "\n链接：" + ("" + history_field(q, "source_url"))
    s
}
fn item_text(it){
    let s = it.title + " " + it.brand + " " + it.description
    for c in it.categories { s = s + " " + c }
    for f in it.features { s = s + " " + f }
    for k v in it.technical_details { if v != nil { s = s + " " + k + " " + ("" + v) } }
    s
}
fn has_index(arr, i){
    let f = false
    for v in arr { if v == i { f = true } }
    f
}
fn top3(pool){
    let out = []
    let used = []
    for n in 3 {
        let best = -1
        let best_score = -999999
        for i in pool.len() {
            if !has_index(used, i) {
                if pool[i].score > best_score {
                    best_score = pool[i].score
                    best = i
                }
            }
        }
        if best >= 0 {
            out.push(pool[best])
            used.push(best)
        }
    }
    out
}

// ---- deterministic 决策结构与只读替代（不改变 hard/budget 筛选语义）----
// 单个 hard 关键词在真实目录字段中的 literal evidence（逐词 term/evidence）。
fn evidence_for_term(it, term){ build_evidence(it, [term]) }
// 逐词列出 hard 关键词的 literal evidence；未命中的词 evidence 为空，不造事实。
fn hard_evidence_of(it, hard_list){
    let out = []
    for kw in hard_list {
        if kw != "" { out.push({term: kw evidence: evidence_for_term(it, kw)}) }
    }
    out
}
// 预算内但缺少 literal 证据的 hard 关键词原词；只说明“未证实”，不改写或删除原词。
fn missing_hard_of(it, hard_list){
    let out = []
    for kw in hard_list {
        if kw != "" {
            if !literal_match(kw, item_text(it)) { out.push(kw) }
        }
    }
    out
}
// 该商品是否满足 need 提到的全部 active 软偏好（每组都有目录原始字段证据）。
fn all_prefs_documented(it, need_text){
    let all_documented = true
    let checks = pref_checks(it, need_text)
    for c in checks {
        if c.evidence_status != "documented" { all_documented = false }
    }
    all_documented
}
// 手动选最小：先比 missing_count 升序，再比 price 升序，取前 n 个；不引入数组 sort。
fn take_lowest(list, n){
    let out = []
    let used = []
    for k in n {
        let best = -1
        let best_missing = 999999
        let best_price = 999999999.0
        for i in list.len() {
            if !has_index(used, i) {
                let mc = list[i].missing_count
                let pr = list[i].price
                if mc < best_missing {
                    best_missing = mc best_price = pr best = i
                } else {
                    if mc == best_missing {
                        if pr < best_price { best_price = pr best = i }
                    }
                }
            }
        }
        if best >= 0 { out.push(list[best]) used.push(best) }
    }
    out
}
// 一条只读替代：currently_eligible 恒为 false，绝不进入 results/候选。
fn build_alternative(it, kind, missing_words, need_text, budget, hard_list){
    let delta = round((price_of(it) - budget) * 100) / 100
    if delta < 0 { delta = 0 }
    {kind: kind item_id: it.item_id title: it.title brand: it.brand
     price_usd: price_of(it) budget_delta_usd: delta
     missing_hard_keywords: missing_words
     hard_evidence: hard_evidence_of(it, hard_list)
     preference_checks: pref_checks(it, need_text)
     quote: quote_of(it)
     price_is_simulated: has_price_shift && it.item_id == price_shift_item
     currently_eligible: false}
}
// 无合法候选时的只读替代：优先满足全部 hard 但超预算的最低价（最多 2 条，
// kind=budget_change_required）；余额列预算内但缺 hard literal 证据的商品
// （kind=hard_evidence_missing，按缺词少、价格低排序），总共最多 3 条。
// 不列同时超预算且缺 hard 的商品，也不自动删词或改预算。
fn build_no_candidate_alternatives(need_text, budget, hard_list){
    let over = []
    let missing = []
    for it in catalog {
        let all_hard = true
        for kw in hard_list {
            if kw != "" {
                if !literal_match(kw, item_text(it)) { all_hard = false }
            }
        }
        let price = price_of(it)
        if all_hard {
            if price > budget { over.push({item: it price: price missing_count: 0 missing: []}) }
        } else {
            if price <= budget {
                let miss = missing_hard_of(it, hard_list)
                if miss.len() > 0 { missing.push({item: it price: price missing_count: miss.len() missing: miss}) }
            }
        }
    }
    let chosen_over = take_lowest(over, 2)
    let remaining = 3 - chosen_over.len()
    let chosen_missing = take_lowest(missing, remaining)
    let alts = []
    for e in chosen_over {
        alts.push(build_alternative(e.item, "budget_change_required", [], need_text, budget, hard_list))
    }
    for e in chosen_missing {
        alts.push(build_alternative(e.item, "hard_evidence_missing", e.missing, need_text, budget, hard_list))
    }
    alts
}
// 软偏好证据缺口时：仅列满足全部 hard 且 ALL active 偏好 documented 的最低价超预算商品，最多 3 条。
fn build_gap_alternatives(need_text, budget, hard_list){
    let over = []
    for it in catalog {
        let all_hard = true
        for kw in hard_list {
            if kw != "" {
                if !literal_match(kw, item_text(it)) { all_hard = false }
            }
        }
        if all_hard {
            let price = price_of(it)
            if price > budget {
                if all_prefs_documented(it, need_text) {
                    over.push({item: it price: price missing_count: 0 missing: []})
                }
            }
        }
    }
    let chosen = take_lowest(over, 3)
    let alts = []
    for e in chosen {
        alts.push(build_alternative(e.item, "budget_change_required", [], need_text, budget, hard_list))
    }
    alts
}
// 合法候选的 decision 视图：预算内、hard 逐词 literal evidence、复用现有 preference_checks。
fn candidate_check(it, need_text, hard_list){
    {item_id: it.item_id title: it.title price_usd: price_of(it)
     budget_status: "within_budget"
     hard_evidence: hard_evidence_of(it, hard_list)
     preference_checks: pref_checks(it, need_text)}
}
// 决策的规则边界说明；明确替代只读、软偏好不升硬、快照仅商品价且可能为本地模拟。
fn decision_rule_note(){
    "规则说明：预算与硬关键词为强约束，不放宽、不删词；软偏好只认目录原始字段 literal 证据，未证实仅表示本目录未见相关字段，不代表商品不支持；替代商品只读，不进入候选、不能直接生成提案。"
}
fn make_decision(state, need_text, budget_text, budget, hard_list, hard_text, clarification_required, question, candidate_checks, alternatives, request_origin){
    {state: state
     request: {need: need_text budget_usd: budget budget_text: budget_text
               hard_keywords: hard_list hard_text: hard_text catalog_source: catalog_source
               request_origin: request_origin}
     research_revision: research_revision
     merchant_version: merchant_version
     clarification_required: clarification_required
     question: question
     rule_note: decision_rule_note()
     candidate_checks: candidate_checks
     alternatives: alternatives}
}
// 工具输出用的 decision 视图：candidates 已含同样的候选与证据，输出省略重复的 candidate_checks；
// 界面仍用 last_decision 的完整 decision（含 candidate_checks）渲染。
fn decision_output(d){
    {state: d.state request: d.request research_revision: d.research_revision
     merchant_version: d.merchant_version clarification_required: d.clarification_required
     question: d.question rule_note: d.rule_note alternatives: d.alternatives}
}
fn decision_question_for(state){
    if state == "preference_evidence_gap" {
        return "偏好缺证据时，你可以保留当前预算选择合格候选，或手动调整条件后重新研究；不会替你修改条件。"
    }
    ""
}
// 当前 UI 输入/商户版本是否仍与最近一次决策的请求快照一致；不依赖 results 是否非空。
fn decision_inputs_match(){
    if last_decision == nil { return false }
    let req = last_decision.request
    if req.catalog_source != catalog_source { return false }
    if last_decision.merchant_version != merchant_version { return false }
    if req.need != ui.need_input.text() { return false }
    if req.budget_text != ui.budget_input.text() { return false }
    if req.hard_text != ui.keywords_input.text() { return false }
    true
}
fn decision_candidate_line(c){
    let s = c.title + "（item_id " + ("" + c.item_id) + "）价格 " + fmt_money(c.price_usd)
    let und = []
    for pc in c.preference_checks {
        if pc.evidence_status != "documented" { und.push(pc.label) }
    }
    if und.len() > 0 { s = s + "；未证实的偏好：" + join_list(und) }
    s
}
fn decision_alt_line(a){
    let s = a.title + "（item_id " + ("" + a.item_id) + "）价格 " + fmt_money(a.price_usd)
    if a.kind == "budget_change_required" { s = s + "；超出预算 " + fmt_money(a.budget_delta_usd) }
    if a.kind == "hard_evidence_missing" {
        s = s + "；未证实的硬关键词：" + join_list(a.missing_hard_keywords)
    }
    if a.price_is_simulated { s = s + "（本地模拟价，非官网真实变价）" }
    // 每组只展示一个原始字段，完整 evidence/quote 仍在结构化 decision 中。
    for pc in a.preference_checks {
        if pc.evidence_status == "documented" && pc.evidence.len() > 0 {
            let ev = pc.evidence[0]
            s = s + "；" + pc.label + "依据：" + ev.field + "＝" + ev.value
        } else {
            s = s + "；" + pc.label + "：目录未证实，不代表不支持"
        }
    }
    let source_url = history_field(a.quote, "source_url")
    if source_url != nil && ("" + source_url) != "" { s = s + "\n  出处：" + source_url }
    s
}
// 中文只读取舍摘要；不显示原始 enum。条件变化时只显示提示，不冒充当前结论。
fn decision_text(){
    if last_decision == nil { return "" }
    if !decision_inputs_match() { return "条件已变化，请重新研究。" }
    let d = last_decision
    let req = d.request
    if d.state == "invalid_budget" {
        return "本次请求预算无效（输入：" + req.budget_text + "）。" + d.question
    }
    let s = "本次请求：需求「" + req.need + "」；预算 " + fmt_money(req.budget_usd) + " 美元"
    if req.hard_keywords.len() > 0 { s = s + "；硬关键词 " + join_list(req.hard_keywords) }
    s = s + "。\n"
    s = s + catalog_source_note() + "\n"
    if d.state == "no_valid_candidates" {
        s = s + "没有同时满足预算与全部硬关键词的候选。\n"
    } else {
        if d.state == "preference_evidence_gap" {
            s = s + "有满足预算与硬关键词的候选，但软偏好缺乏目录证据（仅表示本演示目录未证实，不代表商品不支持）。\n"
        } else {
            s = s + "找到满足预算与硬关键词的候选。\n"
        }
        for c in d.candidate_checks {
            let rem = round((req.budget_usd - c.price_usd) * 100) / 100
            s = s + "· " + decision_candidate_line(c) + "（预算余量 " + fmt_money(rem) + "）\n"
        }
    }
    if d.alternatives.len() > 0 {
        s = s + "只读替代（仅供比较，不计入候选，不能直接保存）：\n"
        for a in d.alternatives {
            s = s + "· " + decision_alt_line(a) + "\n"
        }
    }
    if d.question != "" { s = s + d.question + "\n" }
    if d.alternatives.len() > 0 {
        s = s + "替代仅供比较；修改需求、预算或硬关键词后需重新研究。"
    }
    s
}
fn render_decision(){
    ui.decision_summary.set_text(decision_text())
}

fn cand_text(i){
    if i >= results.len() { return "" }
    let r = results[i]
    let it = r.item
    let price = price_of(it)
    let rem = budget_value - price
    let s = ("" + (i + 1)) + ". " + it.title + "（" + it.brand + "）\n"
    // 先给用户能直接核对的选择依据：价格/预算余量、必需词字段证据、软偏好证据或未知。
    s = s + "价格 " + fmt_money(price) + " ｜ 预算余量 " + fmt_money(rem) + "\n"
    let hd = hard_evidence_text(it, last_hard_list)
    if hd != "" { s = s + "必需词：" + hd + "\n" }
    let pc = checks_text(results[i].checks)
    if pc != "" { s = s + "软偏好核对：" + pc + "\n" }
    // 事实明细放在选择依据之后；类别/特征/参数/quote 全部保留。
    s = s + "类别：" + join_list(it.categories) + "\n"
    s = s + "事实特征：" + join_list(it.features) + "\n"
    s = s + "参数：" + td_text(it.technical_details) + "\n"
    if has_price_shift && it.item_id == price_shift_item {
        s = s + "价格标记：模拟涨价 ×" + ("" + price_shift_factor) + "（本地模拟，非官网真实变价）\n"
    }
    s = s + quote_summary(quote_of(it))
    s
}
fn evidence_text(r){
    let s = ""
    for m in r.matched { if s != "" { s = s + "、" } s = s + m }
    if s == "" { "无关键词命中，按预算与硬关键词过滤" } else { "命中关键词 " + s }
}
fn evidence_brief(ev){
    let s = ""
    for x in ev {
        if s != "" { s = s + "；" }
        s = s + x.field + "：" + x.value
    }
    s
}
fn checks_text(checks){
    let s = ""
    for c in checks {
        if s != "" { s = s + "；" }
        s = s + c.label + "："
        if c.evidence_status == "documented" {
            s = s + "目录有证据"
            let eb = evidence_brief(c.evidence)
            if eb != "" { s = s + "（" + eb + "）" }
        } else {
            s = s + "目录未证实（本演示目录未见相关字段，不代表商品不支持）"
        }
    }
    s
}

// 候选卡必需词的具体字段证据：逐词列出目录原始字段命中；未命中明确未知，不写“已满足”。
fn hard_evidence_text(it, hard_list){
    let s = ""
    for e in hard_evidence_of(it, hard_list) {
        if s != "" { s = s + "；" }
        if e.evidence.len() == 0 {
            s = s + e.term + "：目录未命中字段证据（未知）"
        } else {
            let ev = e.evidence[0]
            s = s + e.term + "：" + ev.field + "＝" + ev.value
        }
    }
    s
}

// 选择依据快照的简短中文展示：只读提案/草稿保存的那份，不用当前目录或当前 last_decision 重算。
// 对照只是研究记录，不是批准；quote 范围/未知配送沿用已有 quote_summary，不在此重复堆长段。
fn selection_record_text(record){
    if record == nil { return "选择依据：历史提案/草稿未记录选择依据，不能补造。" }
    let kind = history_field(record, "kind")
    if kind == "unknown_legacy" { return "选择依据：历史提案/草稿未记录选择依据，不能补造。" }
    let req = history_field(record, "request")
    let sel = history_field(record, "selected")
    let budget = 0.0
    let need = ""
    let hard = []
    if req != nil {
        let b = history_field(req, "budget_usd")
        if b != nil { budget = b }
        let n = history_field(req, "need")
        if n != nil { need = "" + n }
        let h = history_field(req, "hard_keywords")
        if h != nil { hard = h }
    }
    let price = 0.0
    let rem = 0.0
    let hard_ev = []
    let checks = []
    if sel != nil {
        let p = history_field(sel, "price_usd")
        if p != nil { price = p }
        let r = history_field(sel, "budget_remaining_usd")
        if r != nil { rem = r }
        let he = history_field(sel, "hard_evidence")
        if he != nil { hard_ev = he }
        let pc = history_field(sel, "preference_checks")
        if pc != nil { checks = pc }
    }
    let s = "选择依据（生成提案时）：\n"
    s = s + "当时预算 " + fmt_money(budget) + "；所选商品价 " + fmt_money(price) + "；预算余量 " + fmt_money(rem) + "。\n"
    s = s + "当时需求：「" + need + "」。\n"
    if hard.len() > 0 {
        s = s + "必需关键词（按目录文字核对）：" + join_list(hard) + "\n"
    } else {
        s = s + "硬关键词：无。\n"
    }
    for e in hard_ev {
        if e.evidence.len() == 0 {
            s = s + "· 硬词「" + ("" + e.term) + "」：目录未命中 literal 字段，仅表示本目录未证实。\n"
        } else {
            let first_ev = e.evidence[0]
            s = s + "· 必需「" + ("" + e.term) + "」：" + first_ev.field + "＝" + first_ev.value + "\n"
        }
    }
    for c in checks {
        if c.evidence_status == "documented" && c.evidence.len() > 0 {
            let ev = c.evidence[0]
            s = s + "· " + c.label + "：" + ev.field + "＝" + ev.value + "\n"
        } else {
            s = s + "· " + c.label + "：未证实，不代表不支持。\n"
        }
    }
    let comp = history_field(record, "comparison")
    if comp != nil {
        let prev_req = history_field(comp, "previous_request")
        let prev_budget = 0.0
        let prev_need = ""
        let prev_hard = []
        if prev_req != nil {
            let pb = history_field(prev_req, "budget_usd")
            if pb != nil { prev_budget = pb }
            let pn = history_field(prev_req, "need")
            if pn != nil { prev_need = "" + pn }
            let ph = history_field(prev_req, "hard_keywords")
            if ph != nil { prev_hard = ph }
        }
        s = s + "与上次研究对照：\n"
        s = s + "· 预算 " + fmt_money(prev_budget) + " → " + fmt_money(budget) + "\n"
        if prev_need != need { s = s + "· 需求「" + prev_need + "」→「" + need + "」\n" }
        if prev_hard.to_json() != hard.to_json() {
            s = s + "· 硬关键词 " + join_list(prev_hard) + " → " + join_list(hard) + "\n"
        }
        let diff = round((price - prev_budget) * 100) / 100
        if diff > 0 {
            s = s + "· 商品价 " + fmt_money(price) + " 比上次预算 " + fmt_money(prev_budget) + " 高 " + fmt_money(diff) + "。\n"
        } else {
            if diff == 0 {
                s = s + "· 商品价等于上次预算 " + fmt_money(prev_budget) + "。\n"
            } else {
                s = s + "· 商品价比上次预算 " + fmt_money(prev_budget) + " 低 " + fmt_money(-diff) + "。\n"
            }
        }
    }
    s = s + "以上为当时的目录依据与研究对照；保存仅生成本地采购草稿。"
    s
}

// 紧凑摘要只读已保存的当前格式选择记录；旧记录明确未知，不补造预算或证据。
// 详细字段、来源与完整相邻请求仍由原 selection_record_text 展示。
fn selection_summary_text(record, title, price){
    let s = "选择摘要：" + title + "\n"
    if record == nil { return s + "选择依据未记录，不能补造。" }
    let kind = history_field(record, "kind")
    if kind != "catalog_evidence_snapshot" { return s + "选择依据未记录，不能补造。" }
    let req = record.request
    let sel = record.selected
    s = s + "商品价 " + fmt_money(sel.price_usd) + " ｜ 当时预算 " + fmt_money(req.budget_usd) + " ｜ 余量 " + fmt_money(sel.budget_remaining_usd) + "\n"
    s = s + "当时需求：「" + req.need + "」\n"
    for e in sel.hard_evidence {
        if e.evidence.len() > 0 {
            let ev = e.evidence[0]
            s = s + "必需「" + e.term + "」：" + ev.field + "＝" + ev.value + "\n"
        } else {
            s = s + "必需「" + e.term + "」：目录未证实。\n"
        }
    }
    if req.hard_keywords.len() == 0 { s = s + "必需关键词：无。\n" }
    let pc = checks_text(sel.preference_checks)
    if pc != "" { s = s + "软偏好：" + pc + "\n" }
    let comp = record.comparison
    if comp != nil {
        let prev = comp.previous_request.budget_usd
        let delta = round((req.budget_usd - prev) * 100) / 100
        let gap = round((sel.price_usd - prev) * 100) / 100
        s = s + "相邻研究对照（不是批准）：预算 " + fmt_money(prev) + " → " + fmt_money(req.budget_usd)
        if delta > 0 { s = s + "（预算增加 " + fmt_money(delta) + "）" }
        if delta < 0 { s = s + "（预算减少 " + fmt_money(-delta) + "）" }
        s = s + "；该商品相对旧预算 "
        if gap > 0 { s = s + "超出 " + fmt_money(gap) }
        if gap == 0 { s = s + "持平" }
        if gap < 0 { s = s + "低 " + fmt_money(-gap) }
        s = s + "。"
    }
    return s
}

fn proposal_text(){
    if proposal == nil { return "暂无待确认提案。" }
    // 展示用提案自身保存的快照，不用当前目录 find_item 冒充旧商品。
    let stored_title = history_field(proposal, "title")
    let title = "（提案未含标题）"
    if stored_title != nil { title = "" + stored_title }
    let s = "提案 " + proposal.proposal_id + "（v" + ("" + proposal.revision) + "）\n"
    s = s + "商品：" + title + "（item_id " + ("" + proposal.selected_item_id) + "）\n"
    let feats = history_field(proposal, "features")
    if feats != nil { s = s + "商品特征：" + join_list(feats) + "\n" }
    let src = history_field(proposal, "catalog_source")
    if src != nil { s = s + "目录来源：" + catalog_source_name("" + src) + "\n" }
    let q = history_field(proposal, "quote")
    if q != nil { s = s + quote_summary(q) + "\n" }
    let pc = proposal_checks_text()
    if pc != "" { s = s + "软偏好核对：" + pc + "\n" }
    s = s + "价格 " + fmt_money(proposal.price_usd) + " ｜ 商户版本 " + ("" + proposal.merchant_version) + "\n"
    s = s + "有效期至 " + time_text(proposal.expires_at) + " ｜ 状态：" + proposal.status
    if has_price_shift && proposal.selected_item_id == price_shift_item {
        s = s + "\n价格标记：当前存在模拟涨价 ×" + ("" + price_shift_factor) + "（本地模拟，非官网真实变价；快照价未改动）"
    }
    if proposal.agent_reason != nil { s = s + "\n助手的选择说明：" + proposal.agent_reason }
    let sel = selection_record_text(history_field(proposal, "selection_record"))
    if sel != "" { s = s + "\n" + sel }
    s
}
// 提案摘要复用同一次研究结果里的 preference_checks；重启后无结果时留空。
fn proposal_checks_text(){
    if proposal == nil { return "" }
    if results.len() == 0 { return "" }
    let s = ""
    for i in results.len() {
        if results[i].item.item_id == proposal.selected_item_id {
            s = checks_text(results[i].checks)
        }
    }
    s
}

fn set_card(i, visible, text, selected){
    if i == 0 {
        ui.cand0_card.set_visible(visible)
        ui.cand0_info.set_text(text)
        if selected { ui.cand0_btn.set_text("已选候选 1") } else { ui.cand0_btn.set_text("选择候选 1") }
    }
    if i == 1 {
        ui.cand1_card.set_visible(visible)
        ui.cand1_info.set_text(text)
        if selected { ui.cand1_btn.set_text("已选候选 2") } else { ui.cand1_btn.set_text("选择候选 2") }
    }
    if i == 2 {
        ui.cand2_card.set_visible(visible)
        ui.cand2_info.set_text(text)
        if selected { ui.cand2_btn.set_text("已选候选 3") } else { ui.cand2_btn.set_text("选择候选 3") }
    }
}
fn render_candidates(){
    for i in 3 {
        if i < results.len() {
            set_card(i, true, cand_text(i), i == selected_index)
        } else {
            set_card(i, false, "", false)
        }
    }
    render_decision()
}
fn show_page(n){
    // 只记录非“完整回复”页，供返回按钮使用；n==5 是只读原文页，不覆盖业务页记忆。
    if n != 5 { last_business_page = n }
    ui.input_panel.set_visible(n == 1)
    ui.candidates_panel.set_visible(n == 2)
    ui.proposal_panel.set_visible(n == 3)
    ui.agent_panel.set_visible(n == 3)
    ui.draft_panel.set_visible(n == 4)
    ui.reply_detail_panel.set_visible(n == 5)
    if n == 1 { ui.stage_info.set_text("1 / 4 · 说明你的需求") }
    if n == 2 { ui.stage_info.set_text("2 / 4 · 比较候选与证据") render_decision() }
    if n == 3 {
        ui.stage_info.set_text("3 / 4 · 审阅提案，由你确认")
        refresh_proposal()
    }
    if n == 4 { ui.stage_info.set_text("4 / 4 · 查看本地采购草稿") }
    if n == 5 { ui.stage_info.set_text("办理记录 · 完整回复") switch_reply_view("records") }
}

fn refresh_proposal(){
    // 先沿用原有详细记录与变更提示，再显示紧凑摘要；不修改业务状态。
    ui.proposal_info.set_text(proposal_text())
    // 原详细文本更新后刷新固定标题；标题是纯显示派生，不参与业务判断。
    ui.proposal_state.set_text(proposal_state_text())
    ui.proposal_change_label.set_text(proposal_change_summary())
    let summary = "尚未选择候选，未生成提案。"
    if proposal != nil {
        let title = history_field(proposal, "title")
        if title == nil { title = "（提案未含标题）" }
        summary = selection_summary_text(history_field(proposal, "selection_record"), "" + title, proposal.price_usd)
    }
    ui.proposal_summary.set_text(summary)
}

