    {schema_version: 1 item_id: 1 asin: "B00DEMO001" title: "Amazon Basics Wireless Mouse" brand: "Amazon Basics" price_usd: 11.99 categories: ["Electronics", "Computer Accessories", "Mice"] features: ["2.4 GHz wireless", "1600 DPI", "Ambidextrous shape"] description: "Compact wireless mouse with a USB nano receiver and a long-life battery." technical_details: {connectivity: "2.4 GHz wireless" dpi: 1600 battery: "1 AA"}}
