    {schema_version: 1 item_id: 12 asin: "B00DEMO012" title: "Apple Magic Mouse 2" brand: "Apple" price_usd: 79.0 categories: ["Electronics", "Computer Accessories", "Mice"] features: ["Bluetooth", "Multi-Touch surface", "rechargeable"] description: "Wireless mouse with a Multi-Touch surface and rechargeable battery." technical_details: {connectivity: "Bluetooth" dpi: nil battery: "rechargeable"}}
