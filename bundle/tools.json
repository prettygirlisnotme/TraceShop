          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "proposal_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "merchant_version": {
            "type": "integer"
          },
          "selected_item_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "price_usd": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer"
          },
          "need_snapshot": {
            "type": "string"
          },
          "budget_snapshot": {
            "type": "string"
          },
          "hard_keywords_snapshot": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "research_revision": {
            "type": "integer"
          }
