    },
    {
      "name": "shopping.draft.save",
      "description": "Save a local purchase draft for exactly one pending proposal, after the person confirms it on the host. Re-checks the call is still active, then re-validates the proposal id/revision/research revision/merchant version and the current request snapshot against the app state, requires active again before writing, and independently reads the stored draft back. Never orders or pays. May change stored state: risk destructive, host confirmation required, no auto approval.",
      "implemented_by": "app",
      "risk": "destructive",
      "confirm": "host",
      "auto_approvable": false,
      "input_schema": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "research_revision": {
            "type": "integer",
            "minimum": 1
          },
          "merchant_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "proposal_id",
          "revision",
          "research_revision",
          "merchant_version"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "is_ok": {
            "type": "boolean"
          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "draft_id": {
            "type": "string"
          },
          "proposal_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "research_revision": {
            "type": "integer"
          },
          "merchant_version": {
            "type": "integer"
          },
          "selected_item_id": {
            "type": "integer"
          },
          "price_usd": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "integer"
          },
          "readback_ok": {
            "type": "boolean"
          }
        },
        "required": [
          "is_ok"
        ]
      }
    },
    {
      "name": "shopping.draft.read",
      "description": "Independently read the stored local purchase draft. Reports read_ok separately from matches_current_proposal, and states the verification_scope. With no in-memory proposal, including after restart, it only verifies stored fields and never claims a current proposal match. When a proposal exists, checks IDs, revisions, merchant version, item, price and currency. Legacy missing research revision is reported as -1. Read-only.",
      "implemented_by": "app",
      "risk": "read",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "is_ok": {
            "type": "boolean"
          },
          "present": {
            "type": "boolean"
          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "draft_id": {
            "type": "string"
          },
          "proposal_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "research_revision": {
            "type": "integer"
          },
          "merchant_version": {
            "type": "integer"
          },
          "selected_item_id": {
            "type": "integer"
          },
          "price_usd": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "integer"
          },
          "read_ok": {
            "type": "boolean"
          },
          "current_proposal_present": {
            "type": "boolean"
          },
          "matches_current_proposal": {
            "type": "boolean"
          },
          "verification_scope": {
            "type": "string",
            "enum": [
              "none",
              "stored_fields",
              "proposal_fields"
            ]
          }
        },
        "required": [
          "is_ok"
        ]
      }
    }
  ]
}
